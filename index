  // ==================== BARRE DI PROBABILITÀ PER RISULTATI ESATTI ====================
  function renderExactScoresWithBars(reString) {
    if (!reString) return '';
    const scores = reString.split(/\s{2,}/).filter(s => s.includes('%'));
    const items = scores.map(s => {
      const parts = s.trim().split(':');
      const score = parts[0].trim();
      const perc = parseFloat(parts[1].replace('%', ''));
      return { score, perc };
    }).sort((a,b) => b.perc - a.perc).slice(0, 4);
    if (!items.length) return '';
    const maxPerc = items[0].perc;
    return `<div class="bk"><div class="bk-t">🔮 Risultati esatti più probabili</div>` +
      items.map(it => {
        const barWidth = (it.perc / maxPerc) * 100;
        return `<div class="prob-bar-container">
          <div class="n" style="min-width:40px;">${it.score}</div>
          <div class="prob-bar"><div class="prob-fill" style="width:${barWidth}%;"></div></div>
          <div class="p pos" style="min-width:45px;text-align:right;">${it.perc.toFixed(1)}%</div>
        </div>`;
      }).join('') + `</div>`;
  }

