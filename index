  function historySummary(allRows){
    const rows=allRows||ST.history||[];
    const pending=rows.filter(r=>r.status==='pending').length;
    const win=rows.filter(r=>r.status==='won').length;
    const loss=rows.filter(r=>r.status==='lost').length;
    const resolved=win+loss;
    const winPct=resolved?((win/resolved)*100):0;
    const lossPct=resolved?((loss/resolved)*100):0;
    const byCat={};
    rows.forEach(r=>{const k=r.category||'Altro'; if(!byCat[k]) byCat[k]={cat:k,tot:0,win:0,loss:0,pending:0}; byCat[k].tot++; if(r.status==='won')byCat[k].win++; else if(r.status==='lost')byCat[k].loss++; else byCat[k].pending++;});
    const cats=Object.values(byCat).map(x=>({...x,resolved:x.win+x.loss,winPct:(x.win+x.loss)?(x.win/(x.win+x.loss))*100:0,lossPct:(x.win+x.loss)?(x.loss/(x.win+x.loss))*100:0})).sort((a,b)=>b.tot-a.tot||a.cat.localeCompare(b.cat));
    return {tot:rows.length,pending,win,loss,resolved,winPct,lossPct,cats};
  }
