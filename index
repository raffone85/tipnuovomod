  function sourceLabel(m){return ({ov05:'Ov 0.5 PT',gg:'GG',o25:'Ov 2.5',u25:'U 2.5',mg13:'MG 1-3',ia:'Stats IA',players:'Giocatori',quote:'1X2 Value',gz:'GZ Index',gen:'Generale',hub:'Match Hub',storico:'Storico',datamining:'DataMining'})[m]||m;}
  function histCategoryFromRow(m,r){
    if(m==='ov05') return 'Ov 0.5 PT';
    if(m==='gg') return 'GG';
    if(m==='o25') return 'Ov 2.5';
    if(m==='u25') return 'U 2.5';
