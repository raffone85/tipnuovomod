  // ==================== CONDIZIONE MG 2-4 ====================
  function isMG24(dm) { return dm && dm.pOV15 > 60 && dm.pUN35 > 60; }

  // ==================== FATTORE DATAMINING PER SCORE COMBINATO ====================
  function getDMFactor(dm, market) {
    if (!dm) return 1.0;
    const np = dm.np;
    let perc = 0;
    switch (market) {
      case 'ov05': perc = dm.pOV05pt; break;
      case 'gg': perc = dm.pGG; break;
      case 'o25': perc = dm.pOV25; break;
      case 'u25': perc = dm.pUN35; break;
      case 'mg13': return Math.min(1 + (np / 100), 1.3);
      default: return 1.0;
    }
    const npWeight = Math.min(np / 50, 1.2);
    const percWeight = 0.8 + (perc / 100) * 0.6;
    return npWeight * percWeight;
  }

  // ==================== BADGE SEMAFORICO DATAMINING ====================
  function getDMBadgeClass(dm, market) {
    if (!dm) return '';
    const np = dm.np;
    let perc = 0;
    switch (market) {
      case 'ov05': perc = dm.pOV05pt; break;
      case 'gg': perc = dm.pGG; break;
      case 'o25': perc = dm.pOV25; break;
      case 'u25': perc = dm.pUN35; break;
      default: return 'neu';
    }
    if (np >= 30 && perc >= (market === 'u25' ? 60 : 55)) return 'dm-green';
    if (np >= 15 && perc >= (market === 'u25' ? 50 : 45)) return 'dm-yellow';
    return 'dm-red';
  }

  function dmBadgeHtml(dm, market) {
    if (!dm) return '';
    let perc = 0, quota = 0, label = '';
    switch (market) {
      case 'ov05': perc = dm.pOV05pt; quota = dm.qOV05pt; label = 'OV0.5PT'; break;
      case 'gg': perc = dm.pGG; quota = dm.qGG; label = 'GG'; break;
      case 'o25': perc = dm.pOV25; quota = dm.qOV25; label = 'OV25'; break;
      case 'u25': perc = dm.pUN35; quota = dm.qUN35; label = 'UN35'; break;
      default: return '';
    }
    const badgeClass = getDMBadgeClass(dm, market);
    const icon = badgeClass === 'dm-green' ? '🟢' : badgeClass === 'dm-yellow' ? '🟡' : '🔴';
    return `<span class="badge ${badgeClass}" title="NP=${dm.np}">${icon} ${label}: ${perc.toFixed(0)}% (${quota.toFixed(2)}) NP:${dm.np}</span>`;
  }

  // ==================== VALUE ====================
  function computeValue(perc, quota) {
    if (!quota || quota <= 0) return 0;
    const implied = 1 / quota;
    return (perc / 100) - implied;
  }

  function valueBadgeHtml(dm, market) {
    if (!dm) return '';
    let perc = 0, quota = 0;
    switch (market) {
      case 'ov05': perc = dm.pOV05pt; quota = dm.qOV05pt; break;
      case 'gg': perc = dm.pGG; quota = dm.qGG; break;
      case 'o25': perc = dm.pOV25; quota = dm.qOV25; break;
      case 'u25': perc = dm.pUN35; quota = dm.qUN35; break;
      default: return '';
    }
    const value = computeValue(perc, quota);
    if (value > 0.05) return `<span class="badge value" title="Vantaggio rispetto alla quota">💰 Value +${(value*100).toFixed(1)}%</span>`;
    return '';
  }

  // ==================== BACKTEST ====================
  function parseGoalsFromResult(r) {
    if (!r) return null;
    const match = r.match(/(\d+)\s*-\s*(\d+)/);
    if (!match) return null;
    return { home: parseInt(match[1]), away: parseInt(match[2]), total: parseInt(match[1]) + parseInt(match[2]) };
  }

  function computeBacktestStats() {
    ST.backtestStats = { ov05: { correct: 0, total: 0 }, gg: { correct: 0, total: 0 }, o25: { correct: 0, total: 0 }, u25: { correct: 0, total: 0 }, mg13: { correct: 0, total: 0 } };
    if (!ST.dataMining.length) return;

    ST.dataMining.forEach(dm => {
      const goals = parseGoalsFromResult(dm.r);
      if (!goals) return;

      const ggRow = getGgRows().find(r => normName(r.evento) === normName(dm.match));
      const o25Row = getO25Rows().find(r => normName(r.evento) === normName(dm.match));
      const u25Row = getU25Rows().find(r => normName(r.evento) === normName(dm.match));
      const mg13Row = getMgRows().find(r => normName(r.evento) === normName(dm.match));

      if (ggRow && ggRow.aff >= 3) {
        ST.backtestStats.gg.total++;
        if (goals.home > 0 && goals.away > 0) ST.backtestStats.gg.correct++;
      }
      if (o25Row && o25Row.aff >= 3) {
        ST.backtestStats.o25.total++;
        if (goals.total > 2) ST.backtestStats.o25.correct++;
      }
      if (u25Row && u25Row.aff >= 3) {
        ST.backtestStats.u25.total++;
        if (goals.total < 3) ST.backtestStats.u25.correct++;
      }
      if (mg13Row && mg13Row.aff >= 3) {
        ST.backtestStats.mg13.total++;
        if (goals.total >= 1 && goals.total <= 3) ST.backtestStats.mg13.correct++;
      }
    });
  }

  function updateBacktestDisplay() {
    const el = document.getElementById('backtestInfo');
    if (!el) return;
