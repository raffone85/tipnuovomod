    document.getElementById('controls').innerHTML=`${stabs}<div class="toolbar"><input class="search" id="searchIn" placeholder="Cerca evento, squadra, giocatore..." value="${escapeHtml(ST.q)}">${leagueDropdown}<button class="pdf-btn" id="pdfBtn">${svgPDF}<span>Scarica PDF</span></button></div><div class="status">Risultati visibili: <strong>${rows.length}</strong></div><div id="uploadStatus" class="up-status">Upload pronto. Seleziona un CSV dal riquadro sopra.</div>`;
  }

  function rowOpenAttr(idx){return `data-open="${idx}" tabindex="0" role="button" aria-label="Apri dettagli"`;}
  function renderRows(){
    const rows=currentRows();
    const main=document.getElementById('main');
    if(ST.market==='storico'){
      const sum=historySummary(ST.history||[]);
      const stats=`<div class="statsgrid"><div class="statcard"><div class="k">Totali</div><div class="v">${sum.tot}</div></div><div class="statcard"><div class="k">Vinte</div><div class="v">${sum.win}</div></div><div class="statcard"><div class="k">Perse</div><div class="v">${sum.loss}</div></div><div class="statcard"><div class="k">% vinte</div><div class="v">${fmt(sum.winPct,1)}%</div></div><div class="statcard"><div class="k">% perse</div><div class="v">${fmt(sum.lossPct,1)}%</div></div><div class="statcard"><div class="k">In attesa</div><div class="v">${sum.pending}</div></div></div>`;
      const table=sum.cats.length?`<table class="tablemini"><thead><tr><th>Categoria</th><th>Tot</th><th>V</th><th>P</th><th>Att</th><th>% V</th><th>% P</th></tr></thead><tbody>${sum.cats.map(c=>`<tr><td>${escapeHtml(c.cat)}</td><td>${c.tot}</td><td>${c.win}</td><td>${c.loss}</td><td>${c.pending}</td><td>${fmt(c.winPct,1)}%</td><td>${fmt(c.lossPct,1)}%</td></tr>`).join('')}</tbody></table>`:'';
      if(!rows.length){main.innerHTML=`<div class="sec"><div class="tag tag-ia">Storico</div><div class="sec-ct">Nessun pronostico salvato</div></div>${stats}${table}<div class="empty"><div class="ico">🧾</div><p>Aggiungi i pronostici dalle sezioni dell'app e aggiorna poi manualmente esito vinta o persa.</p></div>`;return;}
      main.innerHTML=`<div class="sec"><div class="tag tag-ia">Storico</div><div class="sec-ct">${rows.length} elementi visibili</div></div>${stats}${table}<div class="mlist">${rows.map(r=>renderStoricoRow(r)).join('')}</div>`;
      return;
    }
    if(ST.market==='datamining'){
      if(!rows.length){main.innerHTML=`<div class="sec"><div class="tag tag-dm">📊 DataMining</div><div class="sec-ct">Nessun dato</div></div><div class="empty"><div class="ico">📂</div><p>Carica il file DataMining Plus per visualizzare le partite.</p></div>`;return;}
      const list = rows.map((r,i) => {
        const npBadge = r.np >= 30 ? 'good' : r.np >= 15 ? 'warn' : 'neu';
        return `<div class="mrow" ${rowOpenAttr(i)}>
          <div class="m-ora">${escapeHtml(r.ora||'--:--')}</div>
          <div>
            <div class="m-name">${escapeHtml(r.match)}</div>
            <div class="m-sub">
              <span class="badge ${npBadge}">NP: ${r.np}</span>
              <span>1: ${r.p1.toFixed(0)}% (${r.q1.toFixed(2)})</span>
              <span>X: ${r.pX.toFixed(0)}% (${r.qX.toFixed(2)})</span>
              <span>2: ${r.p2.toFixed(0)}% (${r.q2.toFixed(2)})</span>
              <span>OV25: ${r.pOV25.toFixed(0)}% (${r.qOV25.toFixed(2)})</span>
            </div>
          </div>
          <div class="m-right">
            <div class="m-ind ${r.pOV25 > 50 ? 'ind-g' : r.pOV25 > 40 ? 'ind-o' : 'ind-r'}">${r.pOV25.toFixed(0)}%</div>
          </div>
        </div>`;
      }).join('');
      main.innerHTML=`<div class="sec"><div class="tag tag-dm">📊 DataMining Plus</div><div class="sec-ct">${rows.length} partite</div></div><div class="mlist">${list}</div>`;
      return;
    }
    const headerMap={ov05:['tag-m1','Ov 0.5 PT'],gg:['tag-a','GG'],o25:['tag-gen','Ov 2.5'],u25:['tag-b','U 2.5'],mg13:['tag-mg','MG 1-3'],ia:['tag-ia','Stats IA'],players:['tag-a','Giocatori'],quote:['tag-mg','Quote 1X2'],gz:['tag-gz','GZ Index'],gen:['tag-gen','Generale'],hub:['tag-ia','Match Hub']};
    const [cls,lbl]=headerMap[ST.market];
    if(!rows.length){main.innerHTML=`<div class="sec"><div class="tag ${cls}">${lbl}</div><div class="sec-ct">Nessun dato disponibile</div></div><div class="empty"><div class="ico">📂</div><p>Carica il CSV corretto o modifica i filtri per vedere i risultati. I dettagli modali e l'export PDF si attivano quando c'è almeno una riga visibile.</p></div>`;return;}
    const list=rows.map((r,i)=>renderRow(r,i)).join('');
    main.innerHTML=`<div class="sec"><div class="tag ${cls}">${lbl}</div><div class="sec-ct">${rows.length} elementi</div></div><div class="mlist">${list}</div>`;
  }

  function renderRow(r,i){
    if(ST.market==='storico') return renderStoricoRow(r);
    if(ST.market==='datamining'){
      const npBadge = r.np >= 30 ? 'good' : r.np >= 15 ? 'warn' : 'neu';
      let html = `<div class="mrow" ${rowOpenAttr(i)}>
        <div class="m-ora">${escapeHtml(r.ora||'--:--')}</div>
        <div>
          <div class="m-name">${escapeHtml(r.match)}</div>
          <div class="m-sub">
            <span class="badge ${npBadge}">NP: ${r.np}</span>
            <span>1: ${r.p1.toFixed(0)}% (${r.q1.toFixed(2)})</span>
            <span>X: ${r.pX.toFixed(0)}% (${r.qX.toFixed(2)})</span>
            <span>2: ${r.p2.toFixed(0)}% (${r.q2.toFixed(2)})</span>
            <span>OV25: ${r.pOV25.toFixed(0)}% (${r.qOV25.toFixed(2)})</span>
          </div>
        </div>
        <div class="m-right">
          <div class="m-ind ${r.pOV25 > 50 ? 'ind-g' : r.pOV25 > 40 ? 'ind-o' : 'ind-r'}">${r.pOV25.toFixed(0)}%</div>
        </div>
      </div>`;
      return html + `<div class="pickbar"><button class="pickbtn" data-addpick="${i}">➕ Aggiungi allo storico</button></div>`;
    }
    let html='';
    const boosted = r.dm && r.originalAff && r.aff > r.originalAff;
    const affDisplay = boosted ? `<span>${affBadge(r.aff)} <span class="boost-indicator">⬆️</span></span>` : affBadge(r.aff);
    if(ST.market==='ov05'){
      const dmBadge = dmBadgeHtml(r.dm, 'ov05');
      const valueBadge = valueBadgeHtml(r.dm, 'ov05');
      html=`<div class="mrow" ${rowOpenAttr(i)}><div class="m-ora">${escapeHtml(r.ora||'--:--')}</div><div><div class="m-name">${escapeHtml(r.evento)}</div><div class="m-sub">${r.m1?'<span class="badge good">M1</span>':''}${r.gzAlign?`<span class="badge ${r.gzAlign.aligned?'good':'neu'}">GZ ${escapeHtml(r.gzAlign.prob.label)}</span>`:''}${r.qvAlign&&marketSupportsQuote('ov05',r.qvAlign)?`<span class="badge alt">1X2 ${escapeHtml(r.qvAlign.golSide)}</span>`:''}${dmBadge}${valueBadge}</div></div><div class="m-right">${affDisplay}${r.ind?indB(r.ind,'ov05'):r.dm?`<div class="m-ind ${r.dm.ic<=320?'ind-g':r.dm.ic<=340?'ind-o':'ind-r'}">${r.dm.ic}</div>`:''}</div></div>`;
    } else if(['gg','o25','u25'].includes(ST.market)){
      const dmBadge = dmBadgeHtml(r.dm, ST.market);
      const valueBadge = valueBadgeHtml(r.dm, ST.market);
      const indVal = ST.market==='gg'? (r.igbt||r.dm?.igbt) : (r.igbt||r.dm?.igbt);
      html=`<div class="mrow" ${rowOpenAttr(i)}><div class="m-ora">${escapeHtml(r.ora||'--:--')}</div><div><div class="m-name">${escapeHtml(r.evento)}</div><div class="m-sub"><span>${escapeHtml(r.lega||r.nazione||'')}</span>${r.m1?'<span class="badge good">M1</span>':''}${r.gzAlign?`<span class="badge ${r.gzAlign.aligned?'good':'neu'}">GZ ${escapeHtml(r.gzAlign.prob.label)}</span>`:''}${dmBadge}${valueBadge}</div></div><div class="m-right">${affDisplay}${indB(indVal,'igbt')}</div></div>`;
    } else if(ST.market==='mg13'){
      const side=ST.sub==='ospite'?'O':'C';
      const showAff=ST.sub==='ospite'?r.away.aff:r.house.aff;
      const ind=ST.sub==='ospite'?r.ica:r.ich;
      const dm = r.dm;
      const dmStrength = dm && dm.np >= 30 ? 'dm-green' : (dm && dm.np >= 15 ? 'dm-yellow' : 'dm-red');
      const dmBadge = dm ? `<span class="badge ${dmStrength}" title="NP=${dm.np}">📊 MGE:${dm.mge.toFixed(2)} DIFF:${dm.diff.toFixed(2)} NP:${dm.np}</span>` : '';
      const mg24Badge = dm && isMG24(dm) ? `<span class="badge alt">🔥 MG 2-4 (1.50)</span>` : '';
      html=`<div class="mrow" ${rowOpenAttr(i)}><div class="m-ora">${escapeHtml(r.ora||'--:--')}</div><div><div class="m-name">${escapeHtml(r.evento)}</div><div class="m-sub"><span class="badge alt">${ST.sub==='ospite'?'Ospite':'Casa / Mix'}</span>${r.m1c?'<span class="badge good">M1 C</span>':''}${r.m1o?'<span class="badge info">M1 O</span>':''}${dmBadge}${mg24Badge}</div></div><div class="m-right">${affDisplay}${ind?indB(ind,'mg'):dm?`<div class="m-ind ${dm.mge>=3?'ind-g':dm.mge>=2.5?'ind-o':'ind-r'}">${dm.mge.toFixed(1)}</div>`:''}</div></div>`;
    } else if(ST.market==='ia') html=`<div class="mrow" ${rowOpenAttr(i)}><div class="m-ora">${escapeHtml(r.ora||'--:--')}</div><div><div class="m-name">${escapeHtml(r.evento)}</div><div class="m-sub"><span>${escapeHtml(r.lega||'')}</span>${r.stats.slice(0,3).map(s=>`<span class="badge ${s.aff>=3?'good':s.aff>=2?'warn':'neu'}">${escapeHtml(s.key)} ${escapeHtml(s.pred)}</span>`).join('')}</div></div><div class="m-right">${affBadge(r.aff)}<div class="m-ind ind-r">${fmt(r.avgAff,1)}</div></div></div>`;
    else if(ST.market==='players') html=`<div class="mrow" ${rowOpenAttr(i)}><div class="m-ora">${escapeHtml(r.ora||'--:--')}</div><div><div class="m-name">${escapeHtml(r.nome)}</div><div class="m-sub"><span>${escapeHtml(r.squadra||'')}</span><span>${escapeHtml(r.partita||'')}</span></div></div><div class="m-right">${affBadge(r.aff)}<div class="m-ind ${r.level==='hot'?'ind-g':r.level==='warm'?'ind-o':'ind-r'}">${fmt(r.score,1)}</div></div></div>`;
    else if(ST.market==='quote') html=`<div class="mrow" ${rowOpenAttr(i)}><div class="m-ora">${escapeHtml(r.ora||'--:--')}</div><div><div class="m-name">${escapeHtml(r.match)}</div><div class="m-sub">${r.value1?'<span class="badge good">1 value</span>':''}${r.valueX?'<span class="badge warn">X value</span>':''}${r.value2?'<span class="badge info">2 value</span>':''}${r.golSide?`<span class="badge alt">${escapeHtml(r.golSide)}</span>`:''}</div></div><div class="m-right"><div class="m-ind ${r.score>=0.8?'ind-g':r.score>=0.35?'ind-o':'ind-r'}">${fmt(r.score,2)}</div></div></div>`;
    else if(ST.market==='gz') html=`<div class="mrow" ${rowOpenAttr(i)}><div class="m-ora">${escapeHtml(r.ora||'--:--')}</div><div><div class="m-name">${escapeHtml(r.evento)}</div><div class="m-sub"><span>${escapeHtml(r.lega||'')}</span><span class="badge ${r.prob.type==='over'?'good':r.prob.type==='under'?'warn':'neu'}">${escapeHtml(r.prob.label)}</span></div></div><div class="m-right"><div class="m-ind ${Math.abs(r.gz||0)>=5000?'ind-g':Math.abs(r.gz||0)>=1200?'ind-o':'ind-r'}">${fmt(r.gz,0)}</div></div></div>`;
    else if(ST.market==='gen') html=`<div class="mrow" ${rowOpenAttr(i)}><div class="m-ora">${escapeHtml(r.ora||'--:--')}</div><div><div class="m-name">${escapeHtml(r.evento)}</div><div class="m-sub"><span class="badge alt">${escapeHtml(r.market)}</span><span>${escapeHtml(r.advice||'')}</span></div></div><div class="m-right">${affBadge(r.aff||3)}<div class="m-ind ind-g">${fmt(r.score,1)}</div></div></div>`;
    else if(ST.market==='hub'){
      const dm = r.dm;
      const dmBadge = dm ? `<span class="badge info" title="NP=${dm.np}">📊 DM: ${dm.np} partite</span>` : '';
      const topPlusBadge = r.advice.main?.tier === 'TOP+' ? `<span class="badge top-plus">🏆 TOP+</span>` : '';
      html=`<div class="mrow" ${rowOpenAttr(i)}><div class="m-ora">${escapeHtml(r.ora||'--:--')}</div><div><div class="m-name">${escapeHtml(r.evento)}</div><div class="m-sub">${r.advice.main?`<span class="badge good">${escapeHtml(r.advice.main.market)}</span>`:''}${r.gzOver?'<span class="badge good">GZ over</span>':''}${r.gzUnder?'<span class="badge warn">GZ under</span>':''}${r.qvForGoals?'<span class="badge alt">1X2 gol</span>':''}${r.qvTight?'<span class="badge info">1X2 draw</span>':''}${dmBadge}${topPlusBadge}<span>${escapeHtml(r.advice.summary)}</span></div></div><div class="m-right">${affBadge(r.aff||3)}<div class="m-ind ${r.conflicts===0?'ind-g':r.conflicts===1?'ind-o':'ind-r'}">${fmt(r.score,1)}</div></div></div>`;
    }
