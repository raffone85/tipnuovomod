      if(h.o25&&h.o25.aff>=4) tips.push({market:'Ov 2.5',tier:'WATCH',score:(h.o25?.score||0)+(h.gzOver?0.4:0),reason:'Buon segnale statistico, manca convergenza totale'});
      if(h.gg&&h.gg.aff>=4) tips.push({market:'GG',tier:'WATCH',score:(h.gg?.score||0)+(h.gzOver?0.3:0),reason:'GG interessante ma non completamente confermato'});
      if(h.ov05&&h.ov05.aff>=4) tips.push({market:'Ov 0.5 PT',tier:'SAFE',score:(h.ov05?.score||0)+(h.gzOver?0.4:0),reason:'Linea prudente anche senza piena convergenza'});
      if(h.u25&&h.u25.aff>=4) tips.push({market:'U 2.5',tier:'WATCH',score:(h.u25?.score||0)+(h.gzUnder?0.4:0),reason:'Under leggibile ma con conferme parziali'});
      if(h.mg13&&h.mg13.aff>=4) tips.push({market:h.mg13.side==='ospite'?'MG 1-3 Ospite':'MG 1-3 Casa',tier:'SMART',score:(h.mg13?.score||0),reason:'Multigol orientato sul lato migliore del match'});
    }
    if(!tips.length){
      if(h.ov05) tips.push({market:'Ov 0.5 PT',tier:'LIGHT',score:h.ov05?.score||0,reason:'Unico segnale disponibile sul match'});
      else if(h.o25) tips.push({market:'Ov 2.5',tier:'LIGHT',score:h.o25?.score||0,reason:'Segnale principale disponibile sul match'});
      else if(h.u25) tips.push({market:'U 2.5',tier:'LIGHT',score:h.u25?.score||0,reason:'Segnale principale disponibile sul match'});
      else if(h.gg) tips.push({market:'GG',tier:'LIGHT',score:h.gg?.score||0,reason:'Segnale principale disponibile sul match'});
      else if(h.mg13) tips.push({market:h.mg13.side==='ospite'?'MG 1-3 Ospite':'MG 1-3 Casa',tier:'LIGHT',score:h.mg13?.score||0,reason:'Lettura MG con dati ancora incompleti'});
    }
    tips.sort((a,b)=>b.score-a.score);
    const main=tips[0]||null,alt=tips[1]||null;
    let risk='Basso'; if(h.conflicts>=2) risk='Alto'; else if(h.conflicts===1) risk='Medio';
    let summary='Nessun dato utile disponibile.';
    if(main){
      const confTxt=h.coverage>=3?'convergenza buona':h.coverage===2?'convergenza media':'copertura leggera';
      summary=`${main.market} ${main.tier}: ${main.reason}. ${confTxt}, copertura ${h.coverage}/5, rischio ${risk}.`;
    }
    return {tips,main,alt,risk,summary};
  }

  function buildHubMatchMap(){
    const map={};
    const ensure=(evento,ora='')=>{const k=normName(evento);if(!k)return null;if(!map[k])map[k]={key:k,evento:evento,ora:ora,ov05:null,gg:null,o25:null,u25:null,mg13:null,ia:null,qv:null,gz:null,dm:null};return map[k];};
    getOv05Rows().forEach(r=>{const m=ensure(r.evento,r.ora);if(m&&!m.ov05)m.ov05=r;});
    getGgRows().forEach(r=>{const m=ensure(r.evento,r.ora);if(m&&!m.gg)m.gg=r;});
    getO25Rows().forEach(r=>{const m=ensure(r.evento,r.ora);if(m&&!m.o25)m.o25=r;});
    getU25Rows().forEach(r=>{const m=ensure(r.evento,r.ora);if(m&&!m.u25)m.u25=r;});
    getMgRows().forEach(r=>{const m=ensure(r.evento,r.ora);if(m&&!m.mg13)m.mg13={...r,aff:Math.max(r.house.aff,r.away.aff),score:Math.max(r.house.total,r.away.total)};});
    getIaRows().forEach(r=>{const m=ensure(r.evento,r.ora);if(m&&!m.ia)m.ia=r;});
    ST.quoteValore.forEach(r=>{const m=ensure(r.match,r.ora);if(m&&!m.qv)m.qv={...r,...analyzeQuoteMatch(r)};});
    ST.gz.forEach(r=>{const m=ensure(r.evento,r.ora);if(m&&!m.gz)m.gz={...r,prob:gzProbability(r.gz)};});
    ST.dataMining.forEach(r=>{const m=ensure(r.match,r.ora);if(m&&!m.dm)m.dm=r;});
    const rows=[];
    for(const m of Object.values(map)){
      const gzOver=!!(m.gz&&m.gz.prob.type==='over');
      const gzUnder=!!(m.gz&&m.gz.prob.type==='under');
      const gzMid=!!(m.gz&&m.gz.prob.type==='neutral');
      const qvForGoals=!!(m.qv&&['casa','ospite','entrambe'].includes(m.qv.golSide));
      const qvBoth=!!(m.qv&&m.qv.golSide==='entrambe');
      const qvTight=!!(m.qv&&m.qv.golSide==='pareggio');
      let coverage=[m.ov05,m.gg||m.o25||m.u25,m.qv,m.gz,m.dm].filter(Boolean).length;
      if(m.dm && m.dm.np>=30) coverage++;
      let conflicts=(m.o25&&gzUnder?1:0)+(m.u25&&gzOver?1:0)+(m.gg&&m.qv&&m.qv.golSide==='pareggio'?1:0);
      if(m.dm){
        if(m.o25&&m.o25.aff>=4&&m.dm.pOV25<45) conflicts++;
        if(m.u25&&m.u25.aff>=4&&m.dm.pUN35<60) conflicts++;
        if(m.gg&&m.gg.aff>=4&&m.dm.pGG<45) conflicts++;
      }
      const conv=(m.gz?1:0)+(m.qv?1:0)+(m.ia&&m.ia.avgAff>=2.5?1:0);
      const h={...m,gzOver,gzUnder,gzMid,qvForGoals,qvBoth,qvTight,coverage,conflicts,conv};
      const advice=hubAdvice(h);
      rows.push({...h,advice,score:advice.main?advice.main.score:0,aff:Math.max(1,Math.min(5,coverage+conv-conflicts))});
    }
    return rows.sort((a,b)=>b.score-a.score||sortTime(a,b));
  }
