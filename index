    } else if(ST.market==='mg13'){
      stabs=`<div class="stabs"><button class="stab ${ST.sub==='m1'?'active':''}" data-sub="m1">M1</button><button class="stab ${ST.sub==='casa'?'active':''}" data-sub="casa">MG 1-3 Casa</button><button class="stab ${ST.sub==='ospite'?'active':''}" data-sub="ospite">MG 1-3 Ospite</button><button class="stab ${ST.sub==='all'?'active':''}" data-sub="all">Tutti</button><button class="stab ${ST.sortMode==='score'?'active':''}" data-sort="score">📊 Score</button><button class="stab ${ST.sortMode==='time'?'active':''}" data-sort="time">⏰ Orario</button></div>`;
    } else if(ST.market==='ia'){
      const cats=[['all','Tutte'],['TT','TT'],['TIP','TiP'],['COR','Corner'],['FAL','Falli'],['FG','FG']];
      stabs=`<div class="stabs">${cats.map(([v,l])=>`<button class="stab ${ST.iaCat===v?'active':''}" data-iacat="${v}">${l}</button>`).join('')}<button class="stab ${ST.sortMode==='score'?'active':''}" data-sort="score">📊 Score</button><button class="stab ${ST.sortMode==='time'?'active':''}" data-sort="time">⏰ Orario</button></div>`;
    } else if(ST.market==='players'){
      stabs=`<div class="stabs"><button class="stab ${ST.plSub==='cards'?'active':''}" data-plsub="cards">Cartellini</button><button class="stab ${ST.plSub==='shots'?'active':''}" data-plsub="shots">Tiri/Gol</button><button class="stab ${ST.sortMode==='score'?'active':''}" data-sort="score">📊 Score</button><button class="stab ${ST.sortMode==='time'?'active':''}" data-sort="time">⏰ Orario</button></div>`;
    } else if(ST.market==='quote'){
      const opts=[['all','Tutti'],['casa','Casa'],['ospite','Ospite'],['pareggio','Pareggio'],['entrambe','Entrambe']];
      stabs=`<div class="stabs">${opts.map(([v,l])=>`<button class="stab ${ST.quoteFilter===v?'active':''}" data-qfilter="${v}">${l}</button>`).join('')}<button class="stab ${ST.sortMode==='score'?'active':''}" data-sort="score">📊 Spread</button><button class="stab ${ST.sortMode==='time'?'active':''}" data-sort="time">⏰ Orario</button></div>`;
