    const iSCQuota = iSCPerc + 1;
    const iSOPerc = idx('SO');
    const iIGBO = idx('IGBO');
    const iSOQuota = iSOPerc + 1;
    const iRE = idx('RE');

    const R = [];
    for (let i = 1; i < L.length; i++) {
      const f = splitCsvLine(L[i], sep).map(s);
