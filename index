  function readFileAsText(file){
    if(file && typeof file.text==='function') return file.text();
    return new Promise((resolve,reject)=>{
      const fr=new FileReader();
      fr.onload=()=>resolve(String(fr.result||''));
      fr.onerror=()=>reject(fr.error||new Error('Lettura file non riuscita'));
      fr.readAsText(file);
    });
  }
  async function handleUploadInput(input){
    const key=input?.dataset?.target;
    const file=input?.files?.[0];
    if(!key){setUploadStatus('Upload non valido: target mancante.','err');return;}
    if(!file){setUploadStatus(`Nessun file selezionato per ${key}.`,'err');return;}
    setUploadStatus(`Lettura file ${file.name} in corso...`);
    try{
      const raw=await readFileAsText(file);
      if(!raw||!raw.trim()) throw new Error('File vuoto o non leggibile');
      parseAndStore(key,raw);
      const count=Array.isArray(ST[key])?ST[key].length:0;
      if(!count) throw new Error('CSV letto ma nessuna riga valida trovata');
      setUploadStatus(`Caricato ${file.name} in ${key}. Righe valide: ${count}.`,'ok');
    }catch(err){
      console.error(err);
      setUploadStatus(`Errore su ${file?.name||'file'} (${key}): ${err?.message||err}`,'err');
      alert('Errore nel parsing del CSV: controlla intestazioni, separatore o compatibilità del file.');
    }finally{input.value='';}
  }
  function bindUploadInputs(){
    document.querySelectorAll('input[type="file"][data-target]').forEach(inp=>{inp.onchange=()=>handleUploadInput(inp);});
  }

  // ==================== EVENT LISTENERS E INIZIALIZZAZIONE ====================
  function bindStatic(){
    document.getElementById('mtabs').addEventListener('click',e=>{const b=e.target.closest('.mtab'); if(!b)return; ST.market=b.dataset.m; ST.q=''; ST.league='all'; render();});
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&ST.det)closeDetail();});
    document.getElementById('datasetToggle').addEventListener('click',()=>{
      const panel=document.getElementById('datasetPanel');
      const arrow=document.getElementById('toggleArrow');
      panel.classList.toggle('open');
      arrow.textContent=panel.classList.contains('open')?'▲':'▼';
    });
    document.body.addEventListener('click',e=>{
      const pick=e.target.closest('[data-pick]');
      const clear=e.target.closest('[data-clear]');
      const sub=e.target.closest('[data-sub]');
      const iacat=e.target.closest('[data-iacat]');
      const plsub=e.target.closest('[data-plsub]');
      const sort=e.target.closest('[data-sort]');
      const qf=e.target.closest('[data-qfilter]');
      const gzf=e.target.closest('[data-gzfilter]');
      const gzs=e.target.closest('[data-gzsort]');
      const open=e.target.closest('[data-open]');
      const add=e.target.closest('[data-addpick]');
      const hs=e.target.closest('[data-hset]');
      const hd=e.target.closest('[data-hdel]');
      const hst=e.target.closest('[data-hstatus]');
      const clr=e.target.closest('#histClearResolved');
      const clrAll=e.target.closest('#histClearAllBtn');
      const exp=e.target.closest('#histExportBtn');
      if(pick){const inp=document.getElementById(pick.dataset.pick); if(inp) inp.click(); return;}
      if(clear){clearDatasetState(clear.dataset.clear); ST[clear.dataset.clear]=[]; if(clear.dataset.clear==='plCards'&&ST.plSub==='cards')ST.plSub='shots'; if(clear.dataset.clear==='plShots'&&ST.plSub==='shots')ST.plSub='cards'; setUploadStatus('Dataset resettato.'); render(); return;}
      if(sub){ST.sub=sub.dataset.sub; render(); return;}
      if(iacat){ST.iaCat=iacat.dataset.iacat; render(); return;}
      if(plsub){ST.plSub=plsub.dataset.plsub; render(); return;}
      if(sort){ST.sortMode=sort.dataset.sort; if(ST.market==='gz')ST.gzSort=sort.dataset.sort==='time'?'time':'value'; render(); return;}
      if(qf){ST.quoteFilter=qf.dataset.qfilter; render(); return;}
      if(gzf){ST.gzFilter=gzf.dataset.gzfilter; render(); return;}
      if(gzs){ST.gzSort=gzs.dataset.gzsort; ST.sortMode=gzs.dataset.gzsort==='time'?'time':'score'; render(); return;}
      if(open){openDetail(parseInt(open.dataset.open,10)); return;}
      if(add){ const rows=currentRows(); const r=rows[parseInt(add.dataset.addpick,10)]; if(r) addPickToHistory(r,ST.market); return; }
      if(hs){ setHistoryStatus(hs.dataset.hset,hs.dataset.val); return; }
      if(hd){ removeHistoryItem(hd.dataset.hdel); return; }
      if(hst){ ST.histStatus=hst.dataset.hstatus; render(); return; }
      if(clr){ clearHistoryResolved(); return; }
      if(clrAll){ clearAllHistory(); return; }
      if(exp){ exportHistory(); return; }
    });
    document.body.addEventListener('keydown',e=>{const row=e.target.closest('[data-open]'); if(row&&(e.key==='Enter'||e.key===' ')){e.preventDefault(); openDetail(parseInt(row.dataset.open,10));}});
    document.body.addEventListener('change',e=>{ if(e.target.id==='leagueSel'){ST.league=e.target.value; render();} if(e.target.id==='histCatSel'){ST.histCategory=e.target.value; render();} });
    document.body.addEventListener('input',e=>{if(e.target.id==='searchIn'){ST.q=e.target.value.trim(); renderRows(); buildControls(); const s=document.getElementById('searchIn'); if(s) s.focus(); s?.setSelectionRange(ST.q.length,ST.q.length);}});
    document.body.addEventListener('click',e=>{if(e.target.id==='pdfBtn')downloadPdf();});
  }

  function render(){
    document.querySelectorAll('.mtab').forEach(b=>b.classList.toggle('active',b.dataset.m===ST.market));
    const totals=DATASETS.reduce((s,d)=>s+(ST[d.key]?.length||0),0);
    document.getElementById('hdrInfo').textContent=`Dataset caricati: ${totals} righe • Vista: ${document.querySelector('.mtab.active')?.textContent||''}`;
    updateBacktestDisplay();
    renderUploadGrid();
    buildControls();
    renderRows();
  }

 function initApp(){
    restoreDatasets();
    bindStatic();
    render();
}

// ==================== COMBO FINDER (Analisi incrociata) ====================
function addComboTab() {
  const mtabs = document.getElementById('mtabs');
  if (mtabs && !document.querySelector('.mtab[data-m="combo"]')) {
    const btn = document.createElement('button');
    btn.className = 'mtab';
    btn.setAttribute('data-m', 'combo');
    btn.textContent = 'Combo Finder';
    mtabs.appendChild(btn);
  }
}

function buildComboMatches() {
  const map = new Map();
  function getMatch(evento, ora = '') {
    const key = normName(evento);
    if (!key) return null;
    if (!map.has(key)) {
      map.set(key, {
        key, evento, ora,
        markets: [], conflicts: 0, dm: null, gz: null, qv: null
      });
    }
    return map.get(key);
  }
  getOv05Rows().forEach(r => { const m = getMatch(r.evento, r.ora); if (m && r.aff >= 3) m.markets.push({ type: 'Ov0.5PT', aff: r.aff, score: r.score, data: r }); });
  getGgRows().forEach(r => { const m = getMatch(r.evento, r.ora); if (m && r.aff >= 3) m.markets.push({ type: 'GG', aff: r.aff, score: r.score, data: r }); });
  getO25Rows().forEach(r => { const m = getMatch(r.evento, r.ora); if (m && r.aff >= 3) m.markets.push({ type: 'Ov2.5', aff: r.aff, score: r.score, data: r }); });
  getU25Rows().forEach(r => { const m = getMatch(r.evento, r.ora); if (m && r.aff >= 3) m.markets.push({ type: 'U2.5', aff: r.aff, score: r.score, data: r }); });
  getMgRows().forEach(r => { const m = getMatch(r.evento, r.ora); if (m) { const bestAff = Math.max(r.house.aff, r.away.aff); if (bestAff >= 3) m.markets.push({ type: 'MG1-3', aff: bestAff, score: Math.max(r.house.total, r.away.total), data: r }); } });
  ST.gz.forEach(g => { const m = getMatch(g.evento, g.ora); if (m && g.gz && Math.abs(g.gz) > 1200) m.gz = { value: g.gz, prob: gzProbability(g.gz) }; });
  ST.quoteValore.forEach(q => { const m = getMatch(q.match, q.ora); if (m) { const analysis = analyzeQuoteMatch(q); if (analysis.golSide) m.qv = { side: analysis.golSide, score: analysis.score }; } });
  ST.dataMining.forEach(d => { const m = getMatch(d.match, d.ora); if (m && d.np >= 20) m.dm = d; });

  const results = [];
  for (const m of map.values()) {
    let comboScore = 0, totalAff = 0, hasOverMarket = false, hasUnderMarket = false, hasGG = false, hasMG = false;
    for (const mk of m.markets) {
      comboScore += mk.score;
      totalAff += mk.aff;
      if (mk.type === 'Ov2.5' || mk.type === 'Ov0.5PT') hasOverMarket = true;
      if (mk.type === 'U2.5') hasUnderMarket = true;
      if (mk.type === 'GG') hasGG = true;
      if (mk.type === 'MG1-3') hasMG = true;
    }
    const avgAff = m.markets.length ? totalAff / m.markets.length : 0;
    let conflicts = 0;
    if (m.gz) {
      if (m.gz.prob.type === 'over' && hasUnderMarket) conflicts++;
      if (m.gz.prob.type === 'under' && hasOverMarket) conflicts++;
    }
    if (m.qv && m.qv.side === 'pareggio' && hasGG) conflicts++;
    let dmBonus = 0;
    if (m.dm) {
      if ((hasOverMarket || hasGG) && m.dm.pOV25 > 55) dmBonus += 0.5;
      if (hasUnderMarket && m.dm.pUN35 > 60) dmBonus += 0.5;
      if (m.dm.np >= 40) dmBonus += 0.5;
    }
    const finalScore = comboScore / Math.max(1, m.markets.length) + dmBonus - conflicts * 2;
    let tier = 'WATCH';
    if (m.markets.length >= 2 && avgAff >= 3.5 && conflicts === 0 && finalScore > 6) tier = 'TOP';
    else if (m.markets.length >= 2 && avgAff >= 3 && conflicts <= 1) tier = 'GOOD';
    results.push({
      ...m,
      marketsCount: m.markets.length,
      avgAff, conflicts, comboScore: finalScore, tier, dmBonus,
      score: finalScore,
      aff: Math.min(5, Math.floor(avgAff + (dmBonus * 0.5) - conflicts * 0.5))
    });
  }
  return results.sort((a,b) => b.comboScore - a.comboScore || sortTime(a,b));
}

function getComboRows() {
  let rows = buildComboMatches();
  rows = filt(rows);
  if (ST.sortMode === 'time') rows.sort(sortTime);
  else rows.sort((a,b) => b.comboScore - a.comboScore);
  return rows;
}

function renderComboRow(r, i) {
  const marketsStr = r.markets.map(m => `${m.type}(${m.aff})`).join(', ');
  const tierClass = r.tier === 'TOP' ? 'top-plus' : (r.tier === 'GOOD' ? 'good' : 'neu');
  const tierIcon = r.tier === 'TOP' ? '🏆' : (r.tier === 'GOOD' ? '✅' : '👀');
  const conflictBadge = r.conflicts > 0 ? `<span class="badge warn">⚠️ ${r.conflicts} conflitto/i</span>` : '<span class="badge good">✔️ 0 conflitti</span>';
  const dmBadge = r.dm ? `<span class="badge info">📊 NP:${r.dm.np}</span>` : '';
  const gzBadge = r.gz ? `<span class="badge ${r.gz.prob.type === 'over' ? 'good' : 'warn'}">GZ ${r.gz.prob.label}</span>` : '';
  const qvBadge = r.qv ? `<span class="badge alt">1X2 ${r.qv.side}</span>` : '';
  return `<div class="mrow" data-open="${i}">
    <div class="m-ora">${escapeHtml(r.ora || '--:--')}</div>
    <div>
      <div class="m-name">${escapeHtml(r.evento)}</div>
      <div class="m-sub">
        <span class="badge ${tierClass}">${tierIcon} ${r.tier}</span>
        ${conflictBadge}
        ${dmBadge} ${gzBadge} ${qvBadge}
        <span>Mercati: ${marketsStr}</span>
      </div>
    </div>
    <div class="m-right">
      ${affBadge(r.aff)}
      <div class="m-ind ind-g">${fmt(r.comboScore, 1)}</div>
    </div>
  </div>
  <div class="pickbar"><button class="pickbtn" data-addpick="${i}">➕ Aggiungi allo storico (Combo)</button></div>`;
}

function patchForCombo() {
  addComboTab();
  const originalCurrentRows = window.currentRows;
  window.currentRows = function() {
    if (ST.market === 'combo') return getComboRows();
    return originalCurrentRows();
  };
  setInterval(() => {
    if (ST.market === 'combo') {
      const main = document.getElementById('main');
      if (main && !main.hasAttribute('data-combo-rendered')) {
        const rows = getComboRows();
        if (rows.length) {
          const list = rows.map((r,i) => renderComboRow(r,i)).join('');
          main.innerHTML = `<div class="sec"><div class="tag tag-mg">Combo Finder</div><div class="sec-ct">${rows.length} partite</div></div><div class="mlist">${list}</div>`;
          main.setAttribute('data-combo-rendered', 'true');
        } else {
          main.innerHTML = `<div class="empty"><div class="ico">🔗</div><p>Nessuna combo trovata. Carica più dataset (Ov0.5, GG, O/U, MG, GZ, Quote, DM).</p></div>`;
          main.setAttribute('data-combo-rendered', 'true');
        }
        document.querySelectorAll('[data-addpick]').forEach(btn => {
          btn.removeEventListener('click', comboAddHandler);
          btn.addEventListener('click', comboAddHandler);
        });
      }
    } else {
      const main = document.getElementById('main');
      if (main) main.removeAttribute('data-combo-rendered');
    }
  }, 200);
  function comboAddHandler(e) {
    const idx = parseInt(e.currentTarget.dataset.addpick, 10);
    const rows = getComboRows();
    const r = rows[idx];
    if (r) {
      const comboItem = {
        match: r.evento,
        category: `Combo ${r.tier}`,
        source: `Combo Finder (${r.markets.map(m=>m.type).join(', ')})`,
        ora: r.ora,
        score: r.comboScore,
        aff: r.aff,
        markets: r.markets,
        conflicts: r.conflicts,
        dm: r.dm ? `NP:${r.dm.np}` : null
      };
      addPickToHistory(comboItem, 'combo');
    }
  }
}

setTimeout(() => {
  if (typeof patchForCombo === 'function') patchForCombo();
}, 500);

initApp();
})();
